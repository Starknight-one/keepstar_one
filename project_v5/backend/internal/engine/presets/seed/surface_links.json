{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "surface-links",
      "maxWidth": 720,
      "layout": {"direction": "column", "gap": "sm", "padding": [20, 24, 24, 24]},
      "fill": "#FFFFFF",
      "cornerRadius": 16,
      "stroke": {"thickness": 1, "fill": "#ECECEC"},
      "effect": [
        {"type": "shadow", "offset": {"x": 0, "y": 2}, "blur": 12, "color": "#00000010"}
      ],
      "children": [
        {
          "type": "frame",
          "id": "sl-head",
          "layout": {"direction": "row", "gap": "sm", "align": "center"},
          "children": [
            {
              "type": "icon_font",
              "id": "sl-icon",
              "iconFontName": "sparkles",
              "width": 18,
              "height": 18,
              "fill": "#F0924A"
            },
            {
              "type": "text",
              "id": "sl-title",
              "content": "Your surfaces are live",
              "textStyle": {"fontSize": "lg", "fontWeight": "semibold", "color": "#1a1a1a"}
            }
          ]
        },
        {
          "type": "frame",
          "id": "sl-row",
          "replicate": true,
          "layout": {"direction": "row", "gap": "md", "align": "center", "padding": [12, 16, 12, 16]},
          "fill": "#F7FAFD",
          "cornerRadius": 12,
          "stroke": {"thickness": 1, "fill": "#ECECEC"},
          "children": [
            {
              "type": "icon_font",
              "id": "sl-row-icon",
              "iconFontName": "arrow-right",
              "width": 16,
              "height": 16,
              "fill": "#5BA4D9"
            },
            {
              "type": "frame",
              "id": "sl-row-main",
              "layout": {"direction": "column", "gap": "xs"},
              "children": [
                {
                  "type": "text",
                  "id": "sl-label",
                  "fieldBinding": "label",
                  "textStyle": {"fontSize": "base", "fontWeight": "semibold", "color": "#1a1a1a"}
                },
                {
                  "type": "text",
                  "id": "sl-url",
                  "fieldBinding": "url",
                  "textStyle": {"fontSize": "sm", "color": "#5BA4D9"}
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
