{
  "version": 1,
  "description": "V5-only smoke — 30 English prompts in a single shared session. Mix designed to surface V5's prompt-handling boundaries: when does it pick rebuild vs modify, when does it call catalog_search vs state_filter vs nothing, what preset does it select, and what does the rendered document look like. Run sequentially in one session so state accumulates (drill / refine / continuation prompts depend on prior turns).",
  "prompts": [
    { "id": "p01", "tag": "greeting",     "query": "hi" },
    { "id": "p02", "tag": "greeting",     "query": "hello there" },
    { "id": "p03", "tag": "conversational", "query": "what can you do?" },
    { "id": "p04", "tag": "broad-search", "query": "show me what you have" },
    { "id": "p05", "tag": "broad-search", "query": "what's popular" },
    { "id": "p06", "tag": "specific-search", "query": "show me toners" },
    { "id": "p07", "tag": "specific-search", "query": "creams for dry skin" },
    { "id": "p08", "tag": "specific-search", "query": "anti-aging products under 2000 rubles" },
    { "id": "p09", "tag": "specific-search", "query": "COSRX products" },
    { "id": "p10", "tag": "refine",       "query": "only the cheap ones" },
    { "id": "p11", "tag": "refine",       "query": "show only with rating above 4" },
    { "id": "p12", "tag": "refine",       "query": "just three of them" },
    { "id": "p13", "tag": "drill",        "query": "open the first one" },
    { "id": "p14", "tag": "drill",        "query": "tell me more about the second" },
