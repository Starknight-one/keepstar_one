# V5 smoke per-prompt JSON dumps — kept locally for review, not in git.
# summary.md / prompts.json / meta.json ARE committed. The pattern is
# p<NN>.* (p01.v5.json, p23.v4.trace.json) — using [0-9] to keep
# prompts.json itself committed.
docs/v5-smoke/**/p[0-9]*.json

